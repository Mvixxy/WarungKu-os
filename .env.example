# Postgres connection string — gunakan Neon/Supabase/Vercel Postgres untuk production
DATABASE_URL=postgresql://user:password@your-host/neondb?sslmode=require

# Better Auth — generate secret dengan: openssl rand -base64 32
BETTER_AUTH_SECRET=replace-with-32-byte-random-secret
BETTER_AUTH_URL=https://warung-ku-os.vercel.app
